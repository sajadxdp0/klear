{
  "name": "klear",
  "version": "0.1.0",
  "private": true,
  "description": "Klear — every rupee, cleared. Human-gated AI back office for payment reconciliation, recovery and fraud defense on Cashfree.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "db:seed": "tsx scripts/seed.ts",
    "eval": "tsx eval/run.ts",
    "gen:dataset": "tsx scripts/gen-dataset.ts",
    "train": "python3 ml/train.py",
    "bank:pdf": "python3 ml/gen_bank_pdf.py",
    "demo:reset": "npm run db:seed && npm run eval",
    "agents:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@cashfreepayments/agent-toolkit": "^1.1.0",
    "ai": "^6.0.3",
    "better-sqlite3": "^13.2.0",
    "cashfree-pg": "^6.0.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.3.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.0",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sarvamai": "^1.1.21",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.31.1": true
  }
}
