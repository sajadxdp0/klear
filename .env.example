# ── Cashfree (merchant.cashfree.com → Developers → API keys) ─────────────
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Webhook signatures are keyed with the CLIENT SECRET by default
# (Base64(HMAC-SHA256(x-webhook-timestamp + rawBody, secret))).
# Set this ONLY if you rotate a dedicated webhook secret:
CASHFREE_WEBHOOK_SECRET=
# SecureID / Verification suite — SEPARATE keys from the SecureID dashboard
# (reusing PG keys returns 401, which looks like a code bug):
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=

# ── Sarvam AI (indus.sarvam.ai → API keys) ──────────────────────────────
SARVAM_API_KEY=

# ── Klear ───────────────────────────────────────────────────────────────
# Public URL used inside payment links shown to customers (tunnel in dev)
APP_BASE_URL=http://localhost:3000
DB_PATH=./data/klear.sqlite
